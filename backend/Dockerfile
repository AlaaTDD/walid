# Sheet Nesting backend -- FastAPI + Shapely/GEOS nesting engine.
#
# This container is meant for an always-on host (Render, Railway, Fly.io, a
# VPS, etc.), NOT Vercel: the nesting engine is CPU-heavy (single computations
# can run for minutes), keeps in-memory job/progress state across requests,
# streams Server-Sent Events for live progress, and writes job uploads/output
# to local disk under NESTING_JOBS_ROOT (see backend/app/api/job_storage.py).
# None of that fits a stateless, short-timeout serverless function. See
# /DEPLOYMENT.md for the full two-service deployment picture.

FROM python:3.12-slim AS base

# GEOS (via Shapely) and OpenCV both need native shared libraries that are not
# present in the slim Python image by default.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgeos-c1v5 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY app/ ./app/
COPY nesting_server.py ./
# setuptools' implicit build backend (used automatically since pyproject.toml
# has no [build-system] table -- confirmed compatible with this exact file:
# sheet_nesting_backend.egg-info/ in this repo was generated by this same
# command) auto-discovers the app/ package now that it's present on disk.
RUN pip install --no-cache-dir .

# Persisted job state (uploads, computed layouts, exported TIFFs) lives here.
# Mount a persistent volume at this path on hosts that support it (Fly.io
# volumes, Railway volumes, a VPS bind mount); on hosts without persistent
# volumes, jobs simply do not survive a container restart -- acceptable for a
# stateless print-production tool where each job is short-lived by design.
ENV NESTING_JOBS_ROOT=/data/jobs
RUN mkdir -p /data/jobs

EXPOSE 8000

# --no-access-log matches nesting_server.py's own Uvicorn configuration.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
